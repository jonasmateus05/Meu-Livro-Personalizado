# =============================================================================
# Livro Bíblico Infantil Personalizado — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e preencha. NUNCA versione valores reais.
# Somente variáveis NEXT_PUBLIC_* chegam ao navegador; todas as outras são de servidor.
# =============================================================================

# URL pública do site (usada nos links do e-mail). Em produção: https://seu-dominio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Texto de preço opcional exibido na página (o valor cobrado é sempre o do checkout da Cakto).
NEXT_PUBLIC_PRICE_LABEL=

# --- Supabase ----------------------------------------------------------------
# Conexão Postgres (Project Settings > Database > Connection string). Use o
# "Session pooler" (porta 5432) para o worker e o "Transaction pooler" (6543) em serverless.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Opcional: certificado CA do Supabase (Database > SSL Configuration) para verificar TLS.
DATABASE_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Service role: SOMENTE servidor/worker (upload e URLs assinadas do bucket privado).
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_SOMENTE_NO_SERVIDOR
SUPABASE_BOOKS_BUCKET=books

# --- Cakto ---------------------------------------------------------------------
# Mesma chave secreta configurada no webhook da Cakto (vem no campo "secret" do JSON).
CAKTO_WEBHOOK_SECRET=GERE_UMA_CHAVE_LONGA_E_ALEATORIA
# ID do produto na Cakto (o webhook de outros produtos é ignorado).
CAKTO_PRODUCT_ID=
# Link de checkout da oferta (https://pay.cakto.com.br/...).
CAKTO_CHECKOUT_URL=
# Parâmetros de URL que levam a referência da personalização ao checkout.
CAKTO_CHECKOUT_REF_PARAMS=utm_content,sck,src
# Caminho exato onde a referência volta no webhook (preencha após o teste real; ex.: data.utm_content).
CAKTO_CORRELATION_PATH=
# Valor mínimo esperado em centavos (opcional; abaixo disso o pedido vai para revisão).
CAKTO_EXPECTED_AMOUNT_CENTS=
# true somente durante o teste de integração: grava o payload (mascarado) em webhook_captures.
CAKTO_WEBHOOK_CAPTURE=false

# Liberação automática da geração após associar pagamento e personalização.
# Mantenha false até concluir o teste real descrito em docs/CAKTO.md.
FULFILLMENT_AUTO_RELEASE=false

# --- Resend --------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Bíblia Infantil <livros@seu-dominio-verificado.com.br>
RESEND_REPLY_TO=

# --- Entrega / download --------------------------------------------------------
# Segredo para derivar os tokens dos links de download (32+ caracteres aleatórios).
DOWNLOAD_TOKEN_SECRET=GERE_OUTRA_CHAVE_LONGA_E_ALEATORIA
DOWNLOAD_LINK_TTL_DAYS=14
DOWNLOAD_MAX_COUNT=20
SIGNED_URL_TTL_SECONDS=120

# --- Operação ------------------------------------------------------------------
# Token Bearer das rotas /api/admin/* (24+ caracteres).
ADMIN_API_TOKEN=GERE_UM_TOKEN_ADMIN_LONGO
# Token Bearer da rota /api/jobs/run (Vercel Cron envia automaticamente se definido).
CRON_SECRET=GERE_UM_TOKEN_CRON_LONGO
# Caminho do Chromium (opcional; na imagem Docker do Playwright não é necessário).
CHROMIUM_EXECUTABLE_PATH=
WORKER_POLL_MS=5000
