# Worker de geração de PDF e envio de e-mails.
# A imagem oficial do Playwright já traz o Chromium compatível com playwright-core 1.56.1.
FROM mcr.microsoft.com/playwright:v1.56.1-noble

WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm install --no-save tsx@4
COPY lib ./lib
COPY scripts ./scripts
COPY public/fonts ./public/fonts
COPY tsconfig.json ./

USER pwuser
CMD ["npx", "tsx", "scripts/worker.ts"]
